
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash")

  teamsCreated Team[] @relation("TeamCreator")
  teamMembers TeamMember[] @relation("TeamMember")
  transactionsCreated Transaction[] @relation("TransactionCreator")
  auditLogs AuditLog[]
  ownedAccounts Account[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  createdById String @map("created_by") @db.Uuid
  createdBy   User @relation("TeamCreator",fields: [createdById], references: [id])

  members  TeamMember[]
  budget Budget?
  accounts Account[]
  transactions Transaction[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("teams")
  @@index([createdById])
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid
  teamId  String @map("team_id") @db.Uuid
  team Team @relation(fields: [teamId ], references: [id])
  userId String @map("user_id") @db.Uuid
  user User @relation("TeamMember",fields: [userId], references: [id])
  role String  @default("member") @db.VarChar(20)
  joinedAt    DateTime @default(now()) @map("joined_at")

  @@unique([teamId, userId])
  @@map("team_members")
  @@index([userId], map: "idx_team_members_user")
}

model Budget {
  id String @id @default(uuid()) @db.Uuid

  teamId String @unique @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  totalBudget Decimal @map("total_budget") @db.Decimal(14, 2)
  currency    String  @default("INR") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("budgets")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  accountType String @map("account_type") @db.VarChar(30)

  ownerUserId String? @map("owner_user_id") @db.Uuid
  ownerUser   User?   @relation(fields: [ownerUserId], references: [id])

  name String @db.VarChar(100)

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("accounts")
  @@index([teamId])
  @@index([ownerUserId])
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("TransactionCreator",fields: [createdById], references: [id])

  transactionType String @map("transaction_type") @db.VarChar(30)

  description String?

  ledgerEntries LedgerEntry[]

  referenceId String? @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@map("transactions")
  @@index([createdById])
  @@index([teamId], map: "idx_transactions_team")
}

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  transactionId String @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  accountId String @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String?

  @@map("ledger_entries")
  @@index([transactionId], map: "idx_ledger_transaction")
  @@index([accountId], map: "idx_ledger_account")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  entityType String? @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.Uuid

  action String? @db.VarChar(30)

  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
}