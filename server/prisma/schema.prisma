generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name         String @db.VarChar(100)
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash")

  organizationsCreated Organization[]       @relation("OrganizationCreator")
  organizationMembers  OrganizationMember[] @relation("OrganizationMember")

  teamsCreated Team[]       @relation("TeamCreator")
  teamMembers  TeamMember[] @relation("TeamMember")

  transactionsCreated Transaction[]    @relation("TransactionCreator")
  auditLogs           AuditLog[]
  sentInvitations     TeamInvitation[] @relation("InvitationSender")

  reimbursementClaims ReimbursementClaim[]
  refreshTokens RefreshToken[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(100)

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("OrganizationCreator", fields: [createdById], references: [id])

  members             OrganizationMember[]
  teams               Team[]
  reimbursementClaims ReimbursementClaim[]
  accounts            Account[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation("OrganizationMember", fields: [userId], references: [id], onDelete: Cascade)

  role String @default("member") @db.VarChar(20)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Team {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(100)

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("TeamCreator", fields: [createdById], references: [id])

  members             TeamMember[]
  budget              Budget?
  accounts            Account[]
  transactions        Transaction[]
  invitations         TeamInvitation[]
  reimbursementClaims ReimbursementClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([createdById])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation("TeamMember", fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") @db.VarChar(20)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([teamId, userId])
  @@index([userId], map: "idx_team_members_user")
  @@map("team_members")
}

model TeamInvitation {
  id String @id @default(uuid()) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  email String @db.VarChar(255)

  invitedById String @map("invited_by") @db.Uuid
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  role String @default("member") @db.VarChar(20)

  token String @unique

  status String @default("pending") @db.VarChar(20)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([teamId])
  @@index([email])
  @@map("team_invitations")
}

model Budget {
  id String @id @default(uuid()) @db.Uuid

  teamId String @unique @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  totalBudget Decimal @map("total_budget") @db.Decimal(14, 2)
  currency    String  @default("INR") @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("budgets")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teamId String? @map("team_id") @db.Uuid
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  accountType String @map("account_type") @db.VarChar(30)

  name String @db.VarChar(100)

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([teamId])
  @@map("accounts")
}

model ReimbursementClaim {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String @map("employee_id") @db.Uuid
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  amount      Decimal @db.Decimal(12, 2)
  description String? @db.VarChar(500)

  status String @db.VarChar(30) // PENDING, APPROVED, REJECTED, PAID

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([employeeId])
  @@index([teamId])
  @@index([status])
  @@map("reimbursement_claims")
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid

  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  transactionType String @map("transaction_type") @db.VarChar(30)

  description String?

  ledgerEntries LedgerEntry[]

  referenceId String? @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdById])
  @@index([teamId], map: "idx_transactions_team")
  @@map("transactions")
}

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String?

  @@index([transactionId], map: "idx_ledger_transaction")
  @@index([accountId], map: "idx_ledger_account")
  @@map("ledger_entries")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType String? @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.Uuid

  action String? @db.VarChar(30)

  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
